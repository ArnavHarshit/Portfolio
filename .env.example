# Copy to .env.local for local dev; add the same keys in Vercel > Project > Settings > Environment Variables.

# Public URL of the site (used for link previews and sitemap)
NEXT_PUBLIC_SITE_URL=https://DangerWizard-World.dev

# AI terminal (get a key at console.anthropic.com). Without it the terminal still runs its built-in commands.
ANTHROPIC_API_KEY=

# Blog admin at /admin. Only someone with this password can write posts. Use 12+ random characters.
ADMIN_PASSWORD=
# Optional extra secret for signing login cookies (any long random string)
ADMIN_SECRET=

# Lets /admin publish posts on the live site by committing them to your repo.
# Fine-grained GitHub token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=ArnavHarshit/portfolio
GITHUB_BRANCH=main

# Optional: receive contact-form messages directly (formspree.io form id)
NEXT_PUBLIC_FORMSPREE_ID=
